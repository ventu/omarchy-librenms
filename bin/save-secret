#!/bin/bash
# Write the LibreNMS address and token next to the plugin, mode 600.
# One JSON object arrives on stdin. Anything that is not that object is
# refused and the previous file is left alone.

set -euo pipefail
umask 077

dest="$(cd "$(dirname "$0")/.." && pwd)/secret.json"
tmp="${dest}.tmp"
trap 'rm -f "$tmp"' EXIT

IFS= read -r line || exit 2
printf '%s\n' "$line" > "$tmp"

if ! jq -e '
  type == "object"
  and ((keys | sort) == ["token", "url"])
  and (.url | type == "string" and test("^https?://[^[:space:]@]+$") and length <= 300)
  and (.token | type == "string" and test("^[A-Za-z0-9._~+/-]+$") and length >= 8 and length <= 200)
' "$tmp" >/dev/null; then
  echo "librenms-save: refused" >&2
  exit 2
fi

mv "$tmp" "$dest"
chmod 600 "$dest"
trap - EXIT
